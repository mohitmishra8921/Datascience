   "source": [
    "# checking memory size of numpy arrays as well as size of python list\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "76ead350-2adc-4e88-bdf9-c3d53ceeb8e5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Size of python list: 8056000 bytes\n",
      "size of numpy arrays: 8000 bytes\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "import sys\n",
    "list1 = list(range(1000))\n",
    "array = np.array(list1)\n",
    "print(\"Size of python list:\",sys.getsizeof(list1) *len(list1),\"bytes\")\n",
    "print(\"size of numpy arrays:\",array.nbytes,\"bytes\")"
   ]
  },
