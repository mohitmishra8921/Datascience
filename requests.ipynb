    "import requests\n",
    "for i in range(1,51):\n",
    "    a = requests.get(f\"https://books.toscrape.com/catalogue/page-{i}.html\")\n",
    "    with open(f\"html/page{i}.html\",\"w\") as f:\n",
    "       f.write(a.text)\n",
    "    print(f\"Download page {i} successfully\")"
   ]
