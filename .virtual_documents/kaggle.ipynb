import matplotlib.pyplot as plt 


days = [1,2,3,4,5,6,7]
studying =[2,1,3,4,5,3,3]
playing = [2,1,3,4,5,6,7]
eating = [3,4,5,1,3,4,5]
sleeping = [1,3,4,5,5,1,3]
labels=['Studying','Playing','Eating','Sleeping']
colors = ('#47B39C','#FFC154','#f0f2eb','#2d2923','#D52DB7','#FF2E7E','#FF6B45')

plt.stackplot(days,studying,playing,eating,sleeping,labels=labels,colors=colors)
plt.legend()
plt.title("Student's Daily Routine timing")
plt.xlabel("Day's of week➡️")
plt.ylabel("Hours's Of Day➡️")
plt.tight_layout()
plt.grid(True)



