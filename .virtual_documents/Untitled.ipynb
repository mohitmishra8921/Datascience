import matplotlib.pyplot as plt
fig, axs = plt.subplots(2, 2, figsize=(8, 6))
x = [1, 2, 3, 4, 5]
y1 = [i * 2 for i in x]
y2 = [i ** 2 for i in x]
y3 = [i ** 0.5 for i in x]
y4 = [10 - i for i in x]
ys = [y1, y2, y3, y4]
titles = ['x * 2', 'x squared', 'sqrt(x)', '10 - x']

for i in range(2):
    for j in range(2):
        idx = i * 2 + j
        axs[i, j].plot(x, ys[idx])
        axs[i, j].set_title(titles[idx])
        plt.suptitle("Different Patterns Comparision")

plt.tight_layout()
plt.show()
plt.suptitle("Different Patterns Comparision")


