import numpy as np 
arr = np.array([1,2,3,4,5])
result = []
for num in arr:
    result.append(int(num**2))
print(result)    


import numpy as np #sometime we need to write less line of code to save memory
arr = np.array([1,2,3,4,5])
result = [int(num**2) for num in arr]
print(result)


