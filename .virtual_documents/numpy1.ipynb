import numpy as np 
import time 

size = 1_00_000_00

list1 = list(range(size))
list2 = list(range(size))

arr1 = np.array(list1)
arr2 = np.array(list2)

start = time.time()
result = arr1 + arr2
end = time.time()

print("python numpy addition time :" , end - start)








